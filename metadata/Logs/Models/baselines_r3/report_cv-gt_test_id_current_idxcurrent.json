  "metric_definitions": {
    "minADE/minFDE": "m; best of K branch means (min over branches of the valid-step mean error / error at the last valid step)",
    "NLL": "per-step MARGINAL mixture NLL: mean over valid steps of -log sum_k pi_k N(y_t; mu_kt, Sigma_kt) (branches re-mixed at every step), then mean over samples; density per (POS_SCALE m)^2 = per (100 m)^2 (add 2 ln 100 = 9.2103 per step for per m^2)",
    "top1ADE/top1FDE": "m; branch with the highest pi",
    "meanADE/meanFDE": "m; mixture mean sum_k pi_k mu_kt",
    "trajNLL": "trajectory NLL, one branch shared over the horizon: -log sum_k pi_k prod_{t valid} N(y_t; mu_kt, Sigma_kt), divided by the number of valid steps (as l_mix); same units as NLL; steps independent within a branch",
    "trajNLL_total": "the same, not divided (per-sample total)",
    "ES": "m; energy score of the concatenated valid-step trajectory, M=64 draws (k ~ pi, independent per-step Gaussians given k), unbiased pair term, dedicated generator seed 20260926",
    "H_pi": "nats; branch entropy -sum pi ln pi",
    "branch_sep_15s": "m; mean pairwise distance between branch means at 15 s (0 for K=1)",
    "n_distinct": "branches with pi > 0.05 whose 15 s mean is more than 2.0 sigma_iso (of the higher-weight branch; sigma_iso = sqrt((sx^2+sy^2)/2)) from every higher-weight branch's 15 s mean",
    "covP_Hs": "MC-HPD coverage (128 draws/sample from a dedicated generator seeded 20260925; pre-round-1 reports used the unseeded global RNG); 'overall' averages per-batch fractions weighted by batch size (legacy), 'strata' pool inside/valid over the stratum",
    "mode_entropy": "normalised entropy of the winner (argmin ADE) histogram; 'overall' = batch-weighted mean of per-batch values (legacy), 'strata' = pooled histogram",
    "reacq": "0 = history window holds only detections of the track open at t0; 1 = it also holds detections of an earlier, closed track of the same object (reacquired); 2 = no open track at t0 (slot eligibility only); -1 = no track ids stored",
    "avoid": "1 = the target's reaction layer is active at any logged step t0+1..t0+30 (labels/<run>/<episode>.npz: reaction_active [T,N]); 0 = never active; -1 = no label file for the episode"
  },
