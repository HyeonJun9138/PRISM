  "metric_definitions": {
    "minADE/minFDE": "m; best of K branch means (min over branches of the valid-step mean error / error at the last valid step)",
    "NLL": "per-step MARGINAL mixture NLL: mean over valid steps of -log sum_k pi_k N(y_t; mu_kt, Sigma_kt) (branches re-mixed at every step), then mean over samples; density per (POS_SCALE m)^2 = per (100 m)^2 (add 2 ln 100 = 9.2103 per step for per m^2)",
    "top1ADE/top1FDE": "m; branch with the highest pi",
    "meanADE/meanFDE": "m; mixture mean sum_k pi_k mu_kt",
